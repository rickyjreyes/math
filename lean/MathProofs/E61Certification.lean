import MathProofs.SwiftHohenbergL2
import MathProofs.E16TorusRemark
import MathProofs.E61ExactNorm

/-!
# E61: the continuum spectral threshold of the centered Swift–Hohenberg operator

Manuscript: `papers/e61-pattern-formation-threshold/main.tex` (issue #39). Throughout `d ≥ 1`,
`a > 0`, `k⋆ > 0`, `L_r = rI − a(Δ + k⋆²)²` on `L²(ℝ^d)` with `D(L_r) = H⁴(ℝ^d)` (`SH.Lr`), and
`e^{tL_r}` is the semigroup it generates (`SH.Sr`, `SH.generator`, `SH.generator_domain`);
`L²` solutions are the mild solutions `SH.IsMildSH`, which exist and are unique (`SH.mild_iff`).

* **Theorem E61** (`E61Cert.theorem_e61`): `σ(L_r) = (−∞, r]`, `‖e^{tL_r}‖ = e^{rt}`,
  `r_c = min a(|k|² − k⋆²)² = 0`, maximal growth rate `r` attained exactly on `|k| = k⋆`;
  (1) `E61Cert.stable`, (2) `E61Cert.critical` (strong decay, `‖e^{tL₀}‖ = 1`, no uniform
  exponential stability, `0` is not an `L²` eigenvalue), (3) `E61Cert.unstable`.
* **Proposition (unstable annulus)** (`E61Cert.unstable_band`).
* **Remark (near-onset width)** (`E61Cert.near_onset`).
* **Proposition (periodic-box threshold)** (`E61Cert.periodic_box`, `E61Cert.rcL_tendsto`).
* **Proposition (control-parameter translation)** (`E61Cert.translation`).

The bounded operator `E61ExactNorm.S` of the earlier exact-norm module is the same semigroup
(`E61Cert.exactNorm_eq_Sr`), so its operator-norm theorems concern `e^{tL_r}` with generator
`L_r`, `D(L_r) = H⁴`.
-/

open Filter Topology Complex InnerProductSpace MeasureTheory Set
open scoped ContDiff ComplexConjugate ENNReal

noncomputable section

namespace ReyesMath
namespace E61Cert

open Sobolev SpectralConc FMult SH

variable {d : ℕ}

local notation "Rd" => EuclideanSpace ℝ (Fin d)

theorem lamr_eq_r_iff {r a ks : ℝ} (ha : 0 < a) (hks : 0 ≤ ks) (k : Rd) :
    lamr r a ks k = r ↔ ‖k‖ = ks := by
  rw [← psym_eq_zero_iff hks]; unfold lamr
  constructor
  · intro h
    have : a * psym ks k = 0 := by linarith
    exact (mul_eq_zero.1 this).resolve_left ha.ne'
  · intro h; rw [h]; ring

/-- **Theorem E61**: the operator, its spectrum, the semigroup norm and the threshold. -/
theorem theorem_e61 (hd : 1 ≤ d) {a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) (r : ℝ) :
    (Lr (d := d) r ha.le ks).domain = Hdom 2 ∧
    uspectrum (Lr (d := d) r ha.le ks) = {z : ℂ | z.im = 0 ∧ z.re ≤ r} ∧
    (∀ t, 0 ≤ t → ‖Sr (d := d) r ha.le ks t‖ = Real.exp (r * t)) ∧
    IsLeast (Set.range fun k : Rd => a * psym ks k) 0 ∧
    (∀ k : Rd, lamr r a ks k ≤ r) ∧ (∀ k : Rd, lamr r a ks k = r ↔ ‖k‖ = ks) := by
  refine ⟨rfl, spectrum_Lr hd ha hks.le, fun t ht => opNorm_Sr hd ha.le hks.le ht, ⟨?_, ?_⟩,
    lamr_le ha.le r ks, lamr_eq_r_iff ha hks.le⟩
  · obtain ⟨k, hk⟩ := exists_shell hd hks.le
    exact ⟨k, by simp [(psym_eq_zero_iff hks.le k).2 hk]⟩
  · rintro _ ⟨k, rfl⟩; exact mul_nonneg ha.le (psym_nonneg ks k)

/-- The operator `E61ExactNorm.S` is the semigroup `e^{tL_r}` generated by `L_r` (`t ≥ 0`). -/
theorem exactNorm_eq_Sr {r a ks t : ℝ} (ha : 0 ≤ a) (ht : 0 ≤ t) :
    E61ExactNorm.S (d := d) r a ks t ha ht = Sr r ha ks t := by
  ext1 u; apply FU.injective; apply Lp.ext
  filter_upwards [coeFn_FU_fmul (E61ExactNorm.symbol (d := d) r a ks t)
      (E61ExactNorm.continuous_symbol r a ks t).aestronglyMeasurable
      (E61ExactNorm.norm_symbol_le r a ks t ha ht) u, FU_Sr r ha ks t u] with ξ h1 h2
  rw [show E61ExactNorm.S (d := d) r a ks t ha ht u = fmul _ _ _ u from rfl, h1, h2,
    E61ExactNorm.symbol, esr, max_eq_left ht, E61ExactNorm.growth, lamr, psym]

/-- **E61 (1)**: for `r < 0` every `L²` solution decays exponentially. -/
theorem stable (hd : 1 ≤ d) {r a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) (hr : r < 0)
    {u₀ : L2 d} {u : ℝ → L2 d} (hu : IsMildSH r ha.le ks u₀ u) :
    (∀ t, 0 ≤ t → ‖u t‖ ≤ Real.exp (r * t) * ‖u₀‖) ∧ Tendsto (fun t => ‖u t‖) atTop (𝓝 0) := by
  have hbound : ∀ t, 0 ≤ t → ‖u t‖ ≤ Real.exp (r * t) * ‖u₀‖ := fun t ht => by
    rw [(mild_iff ha hks u₀).2 u hu t ht, ← opNorm_Sr hd ha.le hks.le ht]
    exact (Sr r ha.le ks t).le_opNorm u₀
  refine ⟨hbound, ?_⟩
  have hlim : Tendsto (fun t => Real.exp (r * t) * ‖u₀‖) atTop (𝓝 0) := by
    have := (Real.tendsto_exp_atBot.comp (tendsto_id.const_mul_atTop_of_neg hr)).mul_const ‖u₀‖
    simpa using this
  exact squeeze_zero' (Eventually.of_forall fun t => norm_nonneg _)
    ((eventually_ge_atTop 0).mono fun t ht => hbound t ht) hlim

/-- **E61 (2)**: at `r = 0` every `L²` solution tends strongly to zero, yet `‖e^{tL₀}‖ = 1`, so
the semigroup is not uniformly exponentially stable; `0` is not an `L²` eigenvalue. -/
theorem critical (hd : 1 ≤ d) {a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) :
    (∀ (u₀ : L2 d) (u : ℝ → L2 d), IsMildSH 0 ha.le ks u₀ u →
      Tendsto (fun t => ‖u t‖) atTop (𝓝 0)) ∧
    (∀ t, 0 ≤ t → ‖Sr (d := d) 0 ha.le ks t‖ = 1) ∧
    (¬ ∃ M c : ℝ, 0 < c ∧ ∀ t, 0 ≤ t → ‖Sr (d := d) 0 ha.le ks t‖ ≤ M * Real.exp (-(c * t))) ∧
    (∀ (u : L2 d) (hu : InH 2 u), Lr 0 ha.le ks ⟨u, hu⟩ = 0 → u = 0) := by
  have hA : 0 < 2 * a * ks ^ 2 := by positivity
  have hnorm : ∀ t, 0 ≤ t → ‖Sr (d := d) 0 ha.le ks t‖ = 1 := fun t ht => by
    rw [opNorm_Sr hd ha.le hks.le ht, zero_mul, Real.exp_zero]
  refine ⟨fun u₀ u hu => ?_, hnorm, ?_, fun u hu h0 => ?_⟩
  · rw [isMildSH_iff ha] at hu
    exact decay_of_mu_zero (0 - a * ks ^ 4) hA ha hd (mu_eq ha 0 ks) hu
  · rintro ⟨M, c, hc, hM⟩
    have hlim : Tendsto (fun t => M * Real.exp (-(c * t))) atTop (𝓝 0) := by
      have := (Real.tendsto_exp_atBot.comp
        (tendsto_neg_atTop_atBot.comp (tendsto_id.const_mul_atTop hc))).const_mul M
      simpa using this
    obtain ⟨t, ht1, ht0⟩ := ((hlim.eventually (gt_mem_nhds one_pos)).and
      (eventually_ge_atTop 0)).exists
    have := hM t ht0
    rw [hnorm t ht0] at this
    linarith
  · haveI := nontrivial_Rd hd
    apply FU.injective; rw [map_zero]; apply Lp.ext
    have h1 := FU_Lr 0 ha.le ks ⟨u, hu⟩
    rw [h0, map_zero] at h1
    have hnull : (volume : Measure Rd) (Metric.sphere 0 ks) = 0 :=
      Measure.addHaar_sphere volume 0 ks
    have hae : ∀ᵐ ξ ∂(volume : Measure Rd), ξ ∉ Metric.sphere 0 ks :=
      measure_eq_zero_iff_ae_notMem.1 hnull
    filter_upwards [h1, hae, Lp.coeFn_zero ℂ 2 (volume : Measure Rd)] with ξ h1 h2 h3
    rw [h3] at h1 ⊢
    have hl : lamr 0 a ks ξ ≠ 0 := by
      intro h
      apply h2
      rw [mem_sphere_zero_iff_norm, ← lamr_eq_r_iff ha hks.le]
      exact h
    have : (lamr 0 a ks ξ : ℂ) * FU (u : L2 d) ξ = 0 := h1.symm
    rcases mul_eq_zero.1 this with h | h
    · exact absurd (Complex.ofReal_eq_zero.1 h) hl
    · exact h

/-- **E61 (3)**: for `r > 0` there are nonzero data with `‖e^{tL_r}u₀‖ ≥ e^{rt/2}‖u₀‖`. -/
theorem unstable (hd : 1 ≤ d) {r a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) (hr : 0 < r) :
    ∃ u₀ : L2 d, u₀ ≠ 0 ∧ ∀ t, 0 ≤ t → Real.exp (r * t / 2) * ‖u₀‖ ≤ ‖Sr r ha.le ks t u₀‖ := by
  obtain ⟨k₀, hk₀⟩ := exists_shell hd hks.le
  have hl₀ : lamr r a ks k₀ = r := (lamr_eq_r_iff ha hks.le k₀).2 hk₀
  obtain ⟨ρ, hρ, hball⟩ := Metric.continuous_iff.1 (continuous_lamr (d := d) r a ks) k₀ (r / 2)
    (by positivity)
  have hU : MeasurableSet (Metric.ball k₀ ρ) := measurableSet_ball
  have hfin : volume (Metric.ball k₀ ρ) ≠ ⊤ := measure_ball_lt_top.ne
  have hpos : 0 < (volume (Metric.ball k₀ ρ)).toReal :=
    ENNReal.toReal_pos (Metric.measure_ball_pos volume k₀ hρ).ne' hfin
  set g := ind (Metric.ball k₀ ρ) hU hfin
  have hFu : FU (FU.symm g) = g := LinearIsometryEquiv.apply_symm_apply _ _
  refine ⟨FU.symm g, ?_, fun t ht => ?_⟩
  · intro h
    have : ‖g‖ ^ 2 = 0 := by rw [← hFu, h, map_zero, norm_zero]; ring
    rw [norm_ind_sq] at this
    linarith
  · have key : (Real.exp (r * t / 2) * ‖FU.symm g‖) ^ 2 ≤ ‖Sr r ha.le ks t (FU.symm g)‖ ^ 2 := by
      rw [mul_pow, ← Real.exp_nat_mul, ← norm_FU (FU.symm g), hFu, ← norm_FU (Sr _ _ _ _ _),
        SpectralConc.norm_sq_L2, SpectralConc.norm_sq_L2, ← integral_const_mul]
      refine integral_mono_ae ((integrable_norm_sq_L2 _).const_mul _) (integrable_norm_sq_L2 _) ?_
      filter_upwards [FU_Sr r ha.le ks t (FU.symm g), coeFn_ind (Metric.ball k₀ ρ) hU hfin]
        with ξ h1 h2
      rw [h1, hFu, norm_mul, mul_pow, norm_esr, max_eq_left ht]
      by_cases hmem : ξ ∈ Metric.ball k₀ ρ
      · refine mul_le_mul_of_nonneg_right ?_ (by positivity)
        have h3 := hball ξ hmem
        rw [Real.dist_eq, hl₀] at h3
        have h4 : r / 2 < lamr r a ks ξ := by linarith [(abs_lt.1 h3).1]
        rw [← Real.exp_nat_mul]
        exact Real.exp_le_exp.2 (by push_cast; nlinarith)
      · have : (g : Rd → ℂ) ξ = 0 := by rw [h2, Set.indicator_of_notMem hmem]
        rw [this, norm_zero]; simp
    exact (pow_le_pow_iff_left₀ (by positivity) (norm_nonneg _) two_ne_zero).1 key

/-! ### The unstable band -/

/-- **Proposition (unstable annulus)**: for `r > 0` the unstable wavevectors are exactly
`||k|² − k⋆²| < √(r/a)`; for `0 < r < ak⋆⁴` this is the annulus
`√(k⋆² − √(r/a)) < |k| < √(k⋆² + √(r/a))`; the fastest growth is at `|k| = k⋆`; as `r ↓ 0` both
radii converge to `k⋆`. -/
theorem unstable_band {a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) :
    (∀ {r : ℝ}, 0 < r → ∀ k : Rd, 0 < lamr r a ks k ↔ |‖k‖ ^ 2 - ks ^ 2| < √(r / a)) ∧
    (∀ {r : ℝ}, 0 < r → r < a * ks ^ 4 → ∀ k : Rd, 0 < lamr r a ks k ↔
      √(ks ^ 2 - √(r / a)) < ‖k‖ ∧ ‖k‖ < √(ks ^ 2 + √(r / a))) ∧
    (∀ (r : ℝ) (k : Rd), ‖k‖ = ks → ∀ k' : Rd, lamr r a ks k' ≤ lamr r a ks k) ∧
    Tendsto (fun r => √(ks ^ 2 - √(r / a))) (𝓝[>] 0) (𝓝 ks) ∧
    Tendsto (fun r => √(ks ^ 2 + √(r / a))) (𝓝[>] 0) (𝓝 ks) := by
  have hband : ∀ {r : ℝ}, 0 < r → ∀ k : Rd,
      0 < lamr r a ks k ↔ |‖k‖ ^ 2 - ks ^ 2| < √(r / a) := fun hr k => by
    unfold lamr psym
    rw [sub_pos, mul_comm, ← lt_div_iff₀ ha, Real.lt_sqrt (abs_nonneg _), sq_abs]
  refine ⟨hband, fun {r} hr hr' k => ?_, fun r k hk k' => ?_, ?_, ?_⟩
  · rw [hband hr, abs_lt]
    have hε : √(r / a) < ks ^ 2 := by
      rw [Real.sqrt_lt' (by positivity)]
      rw [div_lt_iff₀ ha]; nlinarith
    rw [Real.sqrt_lt (by linarith) (norm_nonneg _), Real.lt_sqrt (norm_nonneg _)]
    constructor
    · rintro ⟨h1, h2⟩; constructor <;> linarith
    · rintro ⟨h1, h2⟩; constructor <;> linarith
  · rw [(lamr_eq_r_iff ha hks.le k).2 hk]; exact lamr_le ha.le r ks k'
  · have hc : Continuous fun r : ℝ => √(ks ^ 2 - √(r / a)) := by fun_prop
    have := (hc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
    simpa [Real.sqrt_sq hks.le] using this
  · have hc : Continuous fun r : ℝ => √(ks ^ 2 + √(r / a)) := by fun_prop
    have := (hc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
    simpa [Real.sqrt_sq hks.le] using this

/-- **Remark (near-onset width)**: with `|k| = k⋆ + δ`, `λ_r = r − a(2k⋆δ + δ²)²`,
`λ_r = r − 4ak⋆²δ² + O(δ³)`, and both unstable half-widths are asymptotic to
`(2k⋆)⁻¹√(r/a)` as `r ↓ 0`. -/
theorem near_onset {a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) :
    (∀ (r : ℝ) (k : Rd), lamr r a ks k = r - a * (2 * ks * (‖k‖ - ks) + (‖k‖ - ks) ^ 2) ^ 2) ∧
    (∀ r δ : ℝ, |δ| ≤ 1 → |(r - a * (2 * ks * δ + δ ^ 2) ^ 2) - (r - 4 * a * ks ^ 2 * δ ^ 2)| ≤
      a * (4 * ks + 1) * |δ| ^ 3) ∧
    Tendsto (fun r => (√(ks ^ 2 + √(r / a)) - ks) / ((2 * ks)⁻¹ * √(r / a))) (𝓝[>] 0) (𝓝 1) ∧
    Tendsto (fun r => (ks - √(ks ^ 2 - √(r / a))) / ((2 * ks)⁻¹ * √(r / a))) (𝓝[>] 0) (𝓝 1) := by
  refine ⟨fun r k => by unfold lamr psym; ring, fun r δ hδ => ?_, ?_, ?_⟩
  · have e : (r - a * (2 * ks * δ + δ ^ 2) ^ 2) - (r - 4 * a * ks ^ 2 * δ ^ 2) =
        -(a * (4 * ks * δ ^ 3 + δ ^ 4)) := by ring
    rw [e, abs_neg, abs_mul, abs_of_pos ha]
    have h1 : |4 * ks * δ ^ 3 + δ ^ 4| ≤ 4 * ks * |δ| ^ 3 + |δ| ^ 4 := by
      calc |4 * ks * δ ^ 3 + δ ^ 4| ≤ |4 * ks * δ ^ 3| + |δ ^ 4| := abs_add _ _
        _ = 4 * ks * |δ| ^ 3 + |δ| ^ 4 := by
            rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 4 * ks), abs_pow, abs_pow]
    have h2 : |δ| ^ 4 ≤ |δ| ^ 3 := by
      rw [pow_succ]; exact mul_le_of_le_one_right (by positivity) hδ
    have h3 : 4 * ks * |δ| ^ 3 + |δ| ^ 4 ≤ (4 * ks + 1) * |δ| ^ 3 := by nlinarith
    calc a * |4 * ks * δ ^ 3 + δ ^ 4| ≤ a * ((4 * ks + 1) * |δ| ^ 3) :=
          mul_le_mul_of_nonneg_left (h1.trans h3) ha.le
      _ = a * (4 * ks + 1) * |δ| ^ 3 := by ring
  · have hc : Continuous fun r : ℝ => 2 * ks / (√(ks ^ 2 + √(r / a)) + ks) := by
      refine continuous_const.div (by fun_prop) fun r => ?_
      have := Real.sqrt_nonneg (ks ^ 2 + √(r / a)); linarith
    have hlim := (hc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
    have h1 : 2 * ks / (√(ks ^ 2 + √(0 / a)) + ks) = 1 := by
      rw [zero_div, Real.sqrt_zero, add_zero, Real.sqrt_sq hks.le]; field_simp; ring
    rw [h1] at hlim
    refine hlim.congr' (eventually_nhdsWithin_of_forall fun r (hr : 0 < r) => ?_)
    have hε : 0 < √(r / a) := Real.sqrt_pos.2 (div_pos hr ha)
    have hs : 0 ≤ ks ^ 2 + √(r / a) := by positivity
    have hsq := Real.sq_sqrt hs
    have hpos : 0 < √(ks ^ 2 + √(r / a)) + ks := by positivity
    field_simp
    nlinarith
  · have hc : Continuous fun r : ℝ => 2 * ks / (ks + √(ks ^ 2 - √(r / a))) := by
      refine continuous_const.div (by fun_prop) fun r => ?_
      have := Real.sqrt_nonneg (ks ^ 2 - √(r / a)); linarith
    have hlim := (hc.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
    have h1 : 2 * ks / (ks + √(ks ^ 2 - √(0 / a))) = 1 := by
      rw [zero_div, Real.sqrt_zero, sub_zero, Real.sqrt_sq hks.le]; field_simp; ring
    rw [h1] at hlim
    -- eventually `√(r/a) < k⋆²`
    have hev : ∀ᶠ r in 𝓝[>] (0 : ℝ), √(r / a) < ks ^ 2 := by
      have hc' : Continuous fun r : ℝ => √(r / a) := by fun_prop
      have := ((hc'.tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))).eventually
        (gt_mem_nhds (show √(0 / a) < ks ^ 2 by rw [zero_div, Real.sqrt_zero]; positivity))
      exact this
    refine hlim.congr' ((hev.and self_mem_nhdsWithin).mono fun r ⟨hr1, (hr : 0 < r)⟩ => ?_)
    have hε : 0 < √(r / a) := Real.sqrt_pos.2 (div_pos hr ha)
    have hs : 0 ≤ ks ^ 2 - √(r / a) := by linarith
    have hsq := Real.sq_sqrt hs
    have hpos : 0 < ks + √(ks ^ 2 - √(r / a)) := by positivity
    field_simp
    nlinarith

/-! ### Finite periodic domains -/

/-- The torus growth rates `λ_n(r) = r − a(|2πn/L|² − k⋆²)²`. -/
def lamL (L r a ks : ℝ) (n : Fin d → ℤ) : ℝ := r - a * (E16Torus.xi2 L n - ks ^ 2) ^ 2

/-- The torus threshold `r_c(L) = a min_n (|2πn/L|² − k⋆²)²`. -/
def rcL (d : ℕ) (L a ks : ℝ) : ℝ := a * ⨅ n : Fin d → ℤ, (E16Torus.xi2 L n - ks ^ 2) ^ 2

theorem lamT_eq_lamL (L r a ks : ℝ) (n : Fin d → ℤ) :
    E16Torus.lamT L (2 * a * ks ^ 2) a (r - a * ks ^ 4) n = lamL L r a ks n := by
  unfold E16Torus.lamT lamL; ring

theorem exists_min (L : ℝ) [Fact (0 < L)] (ks : ℝ) :
    ∃ n₀ : Fin d → ℤ, ∀ n : Fin d → ℤ,
      (E16Torus.xi2 L n₀ - ks ^ 2) ^ 2 ≤ (E16Torus.xi2 L n - ks ^ 2) ^ 2 := by
  have h0 : Tendsto (fun q : ℝ => q - ks ^ 2) atTop atTop :=
    Tendsto.congr (fun q => (sub_eq_add_neg q (ks ^ 2)).symm)
      (tendsto_atTop_add_const_right atTop (-ks ^ 2) tendsto_id)
  exact (((tendsto_pow_atTop two_ne_zero).comp h0).comp
    (E16Torus.tendsto_xi2 (d := d) (L := L))).exists_forall_le

/-- **Proposition (periodic-box threshold).** On `𝕋_L^d` each Fourier coefficient of the linear
flow solves `∂ₜû_n = λ_n(r)û_n`; the threshold `r_c(L)` is attained by some lattice frequency,
`r_c(L) ≥ 0` with equality iff a lattice wavevector lies on `|k| = k⋆`; all modes decay iff
`r < r_c(L)`, and some mode has nonnegative growth iff `r ≥ r_c(L)`. -/
theorem periodic_box (L : ℝ) [Fact (0 < L)] {a ks : ℝ} (ha : 0 < a) (r : ℝ) :
    (∀ (A₀ : TorusL2.L2 L d) (n : Fin d → ℤ) {t : ℝ}, 0 < t →
      HasDerivAt (fun s => TorusL2.coef (E16Torus.flow L (2 * a * ks ^ 2) (r - a * ks ^ 4) ha s A₀) n)
        ((lamL L r a ks n : ℂ) *
          TorusL2.coef (E16Torus.flow L (2 * a * ks ^ 2) (r - a * ks ^ 4) ha t A₀) n) t) ∧
    (∃ n₀ : Fin d → ℤ, rcL d L a ks = a * (E16Torus.xi2 L n₀ - ks ^ 2) ^ 2 ∧
      ∀ n : Fin d → ℤ, lamL L r a ks n ≤ lamL L r a ks n₀) ∧
    0 ≤ rcL d L a ks ∧
    (rcL d L a ks = 0 ↔ ∃ n : Fin d → ℤ, E16Torus.xi2 L n = ks ^ 2) ∧
    ((∀ n : Fin d → ℤ, lamL L r a ks n < 0) ↔ r < rcL d L a ks) ∧
    ((∃ n : Fin d → ℤ, 0 ≤ lamL L r a ks n) ↔ rcL d L a ks ≤ r) := by
  obtain ⟨n₀, hn₀⟩ := exists_min (d := d) L ks
  have hinf : (⨅ n : Fin d → ℤ, (E16Torus.xi2 L n - ks ^ 2) ^ 2) =
      (E16Torus.xi2 L n₀ - ks ^ 2) ^ 2 :=
    le_antisymm (ciInf_le ⟨0, by rintro _ ⟨n, rfl⟩; positivity⟩ n₀) (le_ciInf hn₀)
  have hrc : rcL d L a ks = a * (E16Torus.xi2 L n₀ - ks ^ 2) ^ 2 := by rw [rcL, hinf]
  have hle : ∀ n, lamL L r a ks n ≤ r - rcL d L a ks := fun n => by
    rw [hrc, lamL]; nlinarith [mul_le_mul_of_nonneg_left (hn₀ n) ha.le]
  have heq : lamL L r a ks n₀ = r - rcL d L a ks := by rw [hrc, lamL]
  refine ⟨fun A₀ n t ht => ?_, ⟨n₀, hrc, fun n => heq ▸ hle n⟩, ?_, ?_, ?_, ?_⟩
  · rw [← lamT_eq_lamL]; exact E16Torus.coef_ode ha ht A₀ n
  · rw [hrc]; positivity
  · rw [hrc]
    constructor
    · intro h
      refine ⟨n₀, ?_⟩
      have := (pow_eq_zero_iff (n := 2) two_ne_zero).1 ((mul_eq_zero.1 h).resolve_left ha.ne')
      linarith
    · rintro ⟨n, hn⟩
      have h1 := hn₀ n
      rw [hn, sub_self, zero_pow two_ne_zero] at h1
      have h2 : (E16Torus.xi2 L n₀ - ks ^ 2) ^ 2 = 0 := le_antisymm h1 (sq_nonneg _)
      rw [h2, mul_zero]
  · constructor
    · intro h; have := h n₀; rw [heq] at this; linarith
    · intro h n; linarith [hle n]
  · constructor
    · rintro ⟨n, hn⟩; linarith [hle n]
    · intro h; exact ⟨n₀, by rw [heq]; linarith⟩

theorem xi2_single (L : ℝ) (hd : 1 ≤ d) (m : ℤ) :
    E16Torus.xi2 L (Pi.single (⟨0, hd⟩ : Fin d) m) = (2 * Real.pi / L * m) ^ 2 := by
  unfold E16Torus.xi2
  rw [Finset.sum_eq_single (⟨0, hd⟩ : Fin d)]
  · simp
  · intro j _ hj; simp [hj]
  · intro h; exact absurd (Finset.mem_univ _) h

/-- **`lim_{L→∞} r_c(L) = 0`.** -/
theorem rcL_tendsto (hd : 1 ≤ d) {a ks : ℝ} (ha : 0 < a) :
    Tendsto (fun L => rcL d L a ks) atTop (𝓝 0) := by
  -- the lattice frequency `2π m(L)/L` with `m(L) = round(Lk⋆/(2π))`
  set m : ℝ → ℤ := fun L => round (L * ks / (2 * Real.pi))
  have hπ : 0 < 2 * Real.pi := Real.two_pi_pos
  have hfreq : Tendsto (fun L => 2 * Real.pi / L * (m L : ℝ)) atTop (𝓝 ks) := by
    have hbd : ∀ L : ℝ, 0 < L → |2 * Real.pi / L * (m L : ℝ) - ks| ≤ Real.pi / L := fun L hL => by
      have h1 := abs_sub_round (L * ks / (2 * Real.pi))
      have e : 2 * Real.pi / L * (m L : ℝ) - ks =
          -(2 * Real.pi / L) * (L * ks / (2 * Real.pi) - (m L : ℝ)) := by
        field_simp; ring
      rw [e, abs_mul, abs_neg, abs_of_pos (div_pos hπ hL)]
      calc 2 * Real.pi / L * |L * ks / (2 * Real.pi) - (m L : ℝ)| ≤ 2 * Real.pi / L * (1 / 2) :=
            mul_le_mul_of_nonneg_left h1 (div_pos hπ hL).le
        _ = Real.pi / L := by ring
    have hlim : Tendsto (fun L : ℝ => Real.pi / L) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop tendsto_id
    rw [tendsto_iff_norm_sub_tendsto_zero]
    exact squeeze_zero' (Eventually.of_forall fun L => norm_nonneg _)
      ((eventually_gt_atTop 0).mono fun L hL => by rw [Real.norm_eq_abs]; exact hbd L hL) hlim
  have hq : Tendsto (fun L => a * ((2 * Real.pi / L * (m L : ℝ)) ^ 2 - ks ^ 2) ^ 2) atTop
      (𝓝 0) := by
    have := ((hfreq.pow 2).sub_const (ks ^ 2)).pow 2 |>.const_mul a
    simpa using this
  refine squeeze_zero' ?_ ?_ hq
  · filter_upwards [eventually_gt_atTop 0] with L hL
    haveI : Fact (0 < L) := ⟨hL⟩
    exact (periodic_box (d := d) L ha 0).2.2.1
  · filter_upwards [eventually_gt_atTop 0] with L hL
    rw [rcL, ← xi2_single L hd]
    exact mul_le_mul_of_nonneg_left
      (ciInf_le ⟨0, by rintro _ ⟨n, rfl⟩; positivity⟩ _) ha.le

/-! ### Centered versus uncentered parameters -/

/-- **Proposition (control-parameter translation)**: `r₀ + α|k|² − b|k|⁴ = μ − b(|k|² − k⋆²)²`
with `k⋆² = α/(2b)` and `μ = r₀ + α²/(4b)`; the uncentered operator is literally `L_μ`
(same weak generator), so its threshold is `μ_c = 0`, i.e. `r₀,c = −α²/(4b)`: some frequency grows
iff `r₀ > −α²/(4b)`. -/
theorem translation (hd : 1 ≤ d) {α b : ℝ} (hα : 0 < α) (hb : 0 < b) (r₀ : ℝ) :
    kstar α b ^ 2 = α / (2 * b) ∧
    (∀ k : Rd, lam α b r₀ k = lamr (r₀ + α ^ 2 / (4 * b)) b (kstar α b) k) ∧
    (∀ u w : L2 d, IsGen α b r₀ u w ↔ ∃ hu : InH 2 u,
      Lr (r₀ + α ^ 2 / (4 * b)) hb.le (kstar α b) ⟨u, hu⟩ = w) ∧
    uspectrum (Lr (d := d) (r₀ + α ^ 2 / (4 * b)) hb.le (kstar α b)) =
      {z : ℂ | z.im = 0 ∧ z.re ≤ r₀ + α ^ 2 / (4 * b)} ∧
    ((∃ k : Rd, 0 < lam α b r₀ k) ↔ -(α ^ 2 / (4 * b)) < r₀) := by
  have hks := kstar_pos hα hb
  have hsym : ∀ k : Rd, lam α b r₀ k = lamr (r₀ + α ^ 2 / (4 * b)) b (kstar α b) k := fun k => by
    rw [lam_eq r₀ hα hb, lamr, psym, mu, qf]
  have hA : 2 * b * kstar α b ^ 2 = α := by rw [kstar_sq hα hb]; field_simp
  have hR : r₀ + α ^ 2 / (4 * b) - b * kstar α b ^ 4 = r₀ := by
    rw [show kstar α b ^ 4 = (kstar α b ^ 2) ^ 2 by ring, kstar_sq hα hb]; field_simp; ring
  refine ⟨kstar_sq hα hb, hsym, fun u w => ?_, spectrum_Lr hd hb hks.le, ?_⟩
  · rw [← isGen_iff_Lr hb, hA, hR]
  · constructor
    · rintro ⟨k, hk⟩
      rw [hsym] at hk
      linarith [lamr_le hb.le (r₀ + α ^ 2 / (4 * b)) (kstar α b) k]
    · intro h
      obtain ⟨k, hk⟩ := exists_shell hd hks.le
      refine ⟨k, ?_⟩
      rw [hsym, (lamr_eq_r_iff hb hks.le k).2 hk]
      linarith

