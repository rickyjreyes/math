import MathProofs.FourierMultiplierL2

/-!
# The Swift–Hohenberg operator on `L²(ℝ^d)` (shared by E57 and E61)

With the unitary Fourier transform `Sobolev.FU`:

* `SH.psym ks ξ = (|ξ|² − k⋆²)²`, `SH.lamr r a ks ξ = r − a(|ξ|² − k⋆²)²`;
* `SH.Aop ks`: the maximal realisation of `𝒜 = (Δ + k⋆²)²`, domain `H⁴(ℝ^d)` (`SH.inH_two_iff`:
  `{u : pû ∈ L²} = H⁴`), nonnegative and self-adjoint (`SH.Aop_isSelfAdjoint`), with form domain
  `H²` (`SH.inH_one_iff`);
* `SH.Lr r ha ks`: `L_r = r − a(Δ + k⋆²)²` with domain `H⁴`, which is exactly the weak generator
  `SpectralConc.IsGen` used by `SpectralConc.IsMild` (`SH.isGen_iff_Lr`);
* `SH.Sr`: the semigroup `e^{tL_r} = 𝓕⁻¹ e^{tλ_r} 𝓕`, a strongly continuous semigroup
  (`SH.Sr_zero`, `SH.Sr_add`, `SH.continuous_Sr`) with `‖e^{tL_r}‖ = e^{rt}` (`SH.opNorm_Sr`),
  generated by `L_r` with domain exactly `H⁴` (`SH.generator`, `SH.generator_domain`);
* the spectrum `σ(L_r) = (−∞, r]` (`SH.spectrum_Lr`);
* mild solutions `SH.IsMildSH` of `∂ₜu = L_r u` exist and are unique, `u(t) = e^{tL_r}u₀`
  (`SH.mild_iff`).
-/

open Filter Topology Complex InnerProductSpace MeasureTheory Set
open scoped ContDiff ComplexConjugate ENNReal

noncomputable section

namespace ReyesMath
namespace SH

open Sobolev SpectralConc FMult

variable {d : ℕ}

local notation "Rd" => EuclideanSpace ℝ (Fin d)

/-! ### Symbols -/

/-- The shell symbol `p(ξ) = (|ξ|² − k⋆²)²`. -/
def psym (ks : ℝ) (ξ : Rd) : ℝ := (‖ξ‖ ^ 2 - ks ^ 2) ^ 2

/-- The growth rate `λ_r(ξ) = r − a(|ξ|² − k⋆²)²`. -/
def lamr (r a ks : ℝ) (ξ : Rd) : ℝ := r - a * psym ks ξ

theorem psym_nonneg (ks : ℝ) (ξ : Rd) : 0 ≤ psym ks ξ := sq_nonneg _

theorem continuous_psym (ks : ℝ) : Continuous (psym (d := d) ks) := by unfold psym; fun_prop

theorem continuous_lamr (r a ks : ℝ) : Continuous (lamr (d := d) r a ks) :=
  continuous_const.sub (continuous_const.mul (continuous_psym ks))

theorem lamr_le {a : ℝ} (ha : 0 ≤ a) (r ks : ℝ) (ξ : Rd) : lamr r a ks ξ ≤ r := by
  have := mul_nonneg ha (psym_nonneg ks ξ); unfold lamr; linarith

/-- A point of the shell `|ξ| = k⋆`. -/
theorem exists_shell (hd : 1 ≤ d) {ks : ℝ} (hks : 0 ≤ ks) : ∃ k : Rd, ‖k‖ = ks :=
  ⟨ks • EuclideanSpace.single (⟨0, hd⟩ : Fin d) 1, by
    rw [norm_smul, EuclideanSpace.norm_single, norm_one, mul_one, Real.norm_eq_abs,
      abs_of_nonneg hks]⟩

theorem psym_eq_zero_iff {ks : ℝ} (hks : 0 ≤ ks) (ξ : Rd) : psym ks ξ = 0 ↔ ‖ξ‖ = ks := by
  unfold psym
  constructor
  · intro h
    have h1 : ‖ξ‖ ^ 2 = ks ^ 2 := by linarith [(pow_eq_zero_iff (n := 2) two_ne_zero).1 h]
    exact (pow_left_inj₀ (norm_nonneg _) hks two_ne_zero).1 h1
  · intro h; rw [h]; ring

/-- `p ≤ (2 + 2k⋆⁴)(1 + |ξ|²)²`. -/
theorem psym_le (ks : ℝ) (ξ : Rd) : psym ks ξ ≤ (2 + 2 * ks ^ 4) * bw ξ ^ 2 := by
  have h1 : 1 ≤ bw ξ := one_le_bw ξ
  have hq0 : 0 ≤ ‖ξ‖ ^ 2 := by positivity
  have hq : ‖ξ‖ ^ 2 ≤ bw ξ := by unfold bw; linarith
  have h2 : (‖ξ‖ ^ 2) ^ 2 ≤ bw ξ ^ 2 := pow_le_pow_left₀ hq0 hq 2
  have h3 : (1 : ℝ) ≤ bw ξ ^ 2 := one_le_pow₀ h1
  have h4 : 0 ≤ (ks ^ 2) ^ 2 := by positivity
  unfold psym
  nlinarith [sq_nonneg (‖ξ‖ ^ 2 + ks ^ 2), mul_le_mul_of_nonneg_left h3 h4]

/-- `(1 + |ξ|²)² ≤ 2p + 2(1 + k⋆²)²`. -/
theorem bw_sq_le_psym (ks : ℝ) (ξ : Rd) : bw ξ ^ 2 ≤ 2 * psym ks ξ + 2 * (1 + ks ^ 2) ^ 2 := by
  unfold bw psym; nlinarith [sq_nonneg (‖ξ‖ ^ 2 - ks ^ 2 - (1 + ks ^ 2))]

theorem norm_psym_le (ks : ℝ) (ξ : Rd) : ‖(psym ks ξ : ℂ)‖ ≤ (2 + 2 * ks ^ 4) * bw ξ ^ 2 := by
  rw [Complex.norm_real, Real.norm_of_nonneg (psym_nonneg ks ξ)]; exact psym_le ks ξ

theorem norm_lamr_le {a : ℝ} (ha : 0 ≤ a) (r ks : ℝ) (ξ : Rd) :
    ‖(lamr r a ks ξ : ℂ)‖ ≤ (|r| + a * (2 + 2 * ks ^ 4)) * bw ξ ^ 2 := by
  rw [Complex.norm_real, Real.norm_eq_abs]
  have h1 : (1 : ℝ) ≤ bw ξ ^ 2 := one_le_pow₀ (one_le_bw ξ)
  have h2 := mul_le_mul_of_nonneg_left (psym_le ks ξ) ha
  have h3 := mul_nonneg ha (psym_nonneg ks ξ)
  have h4 := mul_le_mul_of_nonneg_left h1 (abs_nonneg r)
  unfold lamr
  rw [abs_le]; constructor <;> nlinarith [le_abs_self r, neg_abs_le r]

theorem aesm_psym (ks : ℝ) : AEStronglyMeasurable (fun ξ : Rd => (psym ks ξ : ℂ)) volume :=
  (Complex.continuous_ofReal.comp (continuous_psym ks)).aestronglyMeasurable

theorem aesm_lamr (r a ks : ℝ) :
    AEStronglyMeasurable (fun ξ : Rd => (lamr r a ks ξ : ℂ)) volume :=
  (Complex.continuous_ofReal.comp (continuous_lamr r a ks)).aestronglyMeasurable

/-! ### The operators with domain `H⁴` -/

/-- `𝒜 = (Δ + k⋆²)²` on `L²(ℝ^d)` with domain `H⁴` (the maximal multiplication operator). -/
def Aop (ks : ℝ) : L2 d →ₗ.[ℂ] L2 d := pmulOp 2 _ (aesm_psym ks) (norm_psym_le ks)

/-- `L_r = r − a(Δ + k⋆²)²` on `L²(ℝ^d)` with domain `H⁴`. -/
def Lr (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) : L2 d →ₗ.[ℂ] L2 d :=
  pmulOp 2 _ (aesm_lamr r a ks) (norm_lamr_le ha r ks)

theorem Aop_domain (ks : ℝ) : (Aop (d := d) ks).domain = Hdom 2 := rfl

theorem Lr_domain (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) : (Lr (d := d) r ha ks).domain = Hdom 2 :=
  rfl

theorem FU_Aop (ks : ℝ) (u : (Aop (d := d) ks).domain) :
    (FU (Aop ks u) : Rd → ℂ) =ᵐ[volume] fun ξ => (psym ks ξ : ℂ) * FU (u : L2 d) ξ :=
  FU_pmulOp 2 _ _ _ u

theorem FU_Lr (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) (u : (Lr (d := d) r ha ks).domain) :
    (FU (Lr r ha ks u) : Rd → ℂ) =ᵐ[volume] fun ξ => (lamr r a ks ξ : ℂ) * FU (u : L2 d) ξ :=
  FU_pmulOp 2 _ _ _ u

/-- `L_r = r − a𝒜` on `H⁴`. -/
theorem Lr_eq (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) {u : L2 d} (hu : InH 2 u) :
    Lr r ha ks ⟨u, hu⟩ = (r : ℂ) • u - (a : ℂ) • Aop ks ⟨u, hu⟩ := by
  apply FU.injective; apply Lp.ext
  rw [map_sub, map_smul, map_smul]
  filter_upwards [FU_Lr r ha ks ⟨u, hu⟩, FU_Aop ks ⟨u, hu⟩,
    Lp.coeFn_sub ((r : ℂ) • FU u) ((a : ℂ) • FU (Aop ks ⟨u, hu⟩)),
    Lp.coeFn_smul (r : ℂ) (FU u), Lp.coeFn_smul (a : ℂ) (FU (Aop ks ⟨u, hu⟩))]
    with ξ h1 h2 h3 h4 h5
  rw [h1, h3, Pi.sub_apply, h4, h5, Pi.smul_apply, Pi.smul_apply, h2, smul_eq_mul, smul_eq_mul]
  simp only [lamr]; push_cast; ring

/-- `D(M_p) = {u : pû ∈ L²} = H⁴`. -/
theorem inH_two_iff (ks : ℝ) (u : L2 d) :
    InH 2 u ↔ MemLp (fun ξ => (psym ks ξ : ℂ) * FU u ξ) 2 volume := by
  refine ⟨memLp_mul_of_inH (aesm_psym ks) (norm_psym_le ks), fun h => ?_⟩
  refine MemLp.of_le ((h.norm.const_mul 2).add ((Lp.memLp (FU u)).norm.const_mul
    (2 * (1 + ks ^ 2) ^ 2))) (aestronglyMeasurable_bw_mul 2 u) (Eventually.of_forall fun ξ => ?_)
  have hb := bw_sq_le_psym ks ξ
  have hn := norm_nonneg (FU u ξ)
  have hp := psym_nonneg ks ξ
  simp only [Pi.add_apply]
  calc ‖((bw ξ ^ 2 : ℝ) : ℂ) * FU u ξ‖ = bw ξ ^ 2 * ‖FU u ξ‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    _ ≤ 2 * (psym ks ξ * ‖FU u ξ‖) + 2 * (1 + ks ^ 2) ^ 2 * ‖FU u ξ‖ := by nlinarith
    _ = ‖2 * ‖(psym ks ξ : ℂ) * FU u ξ‖ + 2 * (1 + ks ^ 2) ^ 2 * ‖FU u ξ‖‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hp,
          Real.norm_of_nonneg (by positivity)]

/-- The form domain: `{u : (|ξ|² − k⋆²)û ∈ L²} = H²`. -/
theorem inH_one_iff (ks : ℝ) (u : L2 d) :
    InH 1 u ↔ MemLp (fun ξ => ((‖ξ‖ ^ 2 - ks ^ 2 : ℝ) : ℂ) * FU u ξ) 2 volume := by
  constructor
  · refine memLp_mul_of_inH (m := fun ξ : Rd => ((‖ξ‖ ^ 2 - ks ^ 2 : ℝ) : ℂ))
      (Complex.continuous_ofReal.comp
        ((continuous_norm.pow 2).sub continuous_const)).aestronglyMeasurable
      (C := 1 + ks ^ 2) (fun ξ => ?_)
    rw [Complex.norm_real, Real.norm_eq_abs, pow_one]
    unfold bw
    have h0 : 0 ≤ ‖ξ‖ ^ 2 := by positivity
    rw [abs_le]; constructor <;> nlinarith [sq_nonneg ks]
  · intro h
    refine MemLp.of_le (h.norm.add ((Lp.memLp (FU u)).norm.const_mul (1 + ks ^ 2)))
      (aestronglyMeasurable_bw_mul 1 u) (Eventually.of_forall fun ξ => ?_)
    have hn := norm_nonneg (FU u ξ)
    have h1 : bw ξ ≤ |‖ξ‖ ^ 2 - ks ^ 2| + (1 + ks ^ 2) := by
      unfold bw; linarith [le_abs_self (‖ξ‖ ^ 2 - ks ^ 2)]
    simp only [Pi.add_apply]
    calc ‖((bw ξ ^ 1 : ℝ) : ℂ) * FU u ξ‖ = bw ξ * ‖FU u ξ‖ := by
          rw [norm_mul, Complex.norm_real, pow_one, Real.norm_of_nonneg (bw_pos ξ).le]
      _ ≤ |‖ξ‖ ^ 2 - ks ^ 2| * ‖FU u ξ‖ + (1 + ks ^ 2) * ‖FU u ξ‖ := by nlinarith
      _ = ‖‖((‖ξ‖ ^ 2 - ks ^ 2 : ℝ) : ℂ) * FU u ξ‖ + (1 + ks ^ 2) * ‖FU u ξ‖‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs (‖ξ‖ ^ 2 - ks ^ 2),
            Real.norm_of_nonneg (by positivity)]

/-! ### The weak generator is `L_r` with domain `H⁴` -/

theorem lam_eq_lamr (r a ks : ℝ) (ξ : Rd) :
    lam (2 * a * ks ^ 2) a (r - a * ks ^ 4) ξ = lamr r a ks ξ := by
  unfold lam lamr psym; ring

theorem lam_eq_psym (ks : ℝ) (ξ : Rd) : lam (-2 * ks ^ 2) (-1) (ks ^ 4) ξ = psym ks ξ := by
  unfold lam psym; ring

theorem mu_eq {a : ℝ} (ha : 0 < a) (r ks : ℝ) : mu (2 * a * ks ^ 2) a (r - a * ks ^ 4) = r := by
  unfold mu
  rw [show (2 * a * ks ^ 2) ^ 2 / (4 * a) = a * ks ^ 4 by field_simp [ha.ne']; ring]
  ring

theorem kstar_eq {a : ℝ} (ha : 0 < a) {ks : ℝ} (hks : 0 ≤ ks) : kstar (2 * a * ks ^ 2) a = ks := by
  unfold kstar
  rw [show 2 * a * ks ^ 2 / (2 * a) = ks ^ 2 by field_simp]
  exact Real.sqrt_sq hks

theorem inH_of_ae {r a ks : ℝ} (ha : 0 < a) {u w : L2 d}
    (h : (fun ξ => (lamr r a ks ξ : ℂ) * FU u ξ) =ᵐ[volume] (FU w : Rd → ℂ)) : InH 2 u := by
  have hb : ∀ ξ : Rd, bw ξ ^ 2 ≤
      2 / a * |lamr r a ks ξ| + (2 * (1 + ks ^ 2) ^ 2 + 2 * |r| / a) := fun ξ => by
    have h1 := bw_sq_le_psym ks ξ
    have h2 : a * psym ks ξ ≤ |lamr r a ks ξ| + |r| := by
      have : a * psym ks ξ = r - lamr r a ks ξ := by unfold lamr; ring
      rw [this]; linarith [neg_abs_le (lamr r a ks ξ), le_abs_self r]
    have h3 : psym ks ξ ≤ (|lamr r a ks ξ| + |r|) / a := by rw [le_div_iff₀ ha]; linarith
    have h4 : 2 / a * |lamr r a ks ξ| + 2 * |r| / a = 2 * ((|lamr r a ks ξ| + |r|) / a) := by ring
    linarith
  refine MemLp.of_le (((Lp.memLp (FU w)).norm.const_mul (2 / a)).add
    ((Lp.memLp (FU u)).norm.const_mul (2 * (1 + ks ^ 2) ^ 2 + 2 * |r| / a)))
    (aestronglyMeasurable_bw_mul 2 u) ?_
  filter_upwards [h] with ξ hξ
  have hw : ‖FU w ξ‖ = |lamr r a ks ξ| * ‖FU u ξ‖ := by
    rw [← hξ, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have hc : 0 ≤ 2 * (1 + ks ^ 2) ^ 2 + 2 * |r| / a := by positivity
  have hn := norm_nonneg (FU u ξ)
  have hl := abs_nonneg (lamr r a ks ξ)
  have ha' : 0 ≤ 2 / a := by positivity
  simp only [Pi.add_apply]
  calc ‖((bw ξ ^ 2 : ℝ) : ℂ) * FU u ξ‖ = bw ξ ^ 2 * ‖FU u ξ‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    _ ≤ (2 / a * |lamr r a ks ξ| + (2 * (1 + ks ^ 2) ^ 2 + 2 * |r| / a)) * ‖FU u ξ‖ :=
        mul_le_mul_of_nonneg_right (hb ξ) hn
    _ = ‖2 / a * ‖FU w ξ‖ + (2 * (1 + ks ^ 2) ^ 2 + 2 * |r| / a) * ‖FU u ξ‖‖ := by
        rw [hw, Real.norm_of_nonneg (by positivity)]; ring

/-- **The weak (maximal) generator is `L_r` with domain `H⁴`**: `𝓛u = w` weakly iff `u ∈ H⁴`
and `L_r u = w`. -/
theorem isGen_iff_Lr {r a ks : ℝ} (ha : 0 < a) (u w : L2 d) :
    IsGen (2 * a * ks ^ 2) a (r - a * ks ^ 4) u w ↔
      ∃ hu : InH 2 u, Lr r ha.le ks ⟨u, hu⟩ = w := by
  rw [isGen_iff]
  simp_rw [lam_eq_lamr]
  constructor
  · intro h
    have hu := inH_of_ae ha h
    refine ⟨hu, FU.injective (Lp.ext ?_)⟩
    filter_upwards [FU_Lr r ha.le ks ⟨u, hu⟩, h] with ξ h1 h2
    rw [h1, ← h2]
  · rintro ⟨hu, rfl⟩
    filter_upwards [FU_Lr r ha.le ks ⟨u, hu⟩] with ξ h1
    rw [h1]

/-- The same for `𝒜`: `𝒜u = w` weakly iff `u ∈ H⁴` and `𝒜u = w`. -/
theorem isGen_iff_Aop (ks : ℝ) (u w : L2 d) :
    IsGen (-2 * ks ^ 2) (-1) (ks ^ 4) u w ↔ ∃ hu : InH 2 u, Aop ks ⟨u, hu⟩ = w := by
  rw [isGen_iff]
  simp_rw [lam_eq_psym]
  constructor
  · intro h
    have hu : InH 2 u := by
      rw [inH_two_iff ks]
      exact (Lp.memLp (FU w)).ae_eq h.symm
    refine ⟨hu, FU.injective (Lp.ext ?_)⟩
    filter_upwards [FU_Aop ks ⟨u, hu⟩, h] with ξ h1 h2
    rw [h1, ← h2]
  · rintro ⟨hu, rfl⟩
    filter_upwards [FU_Aop ks ⟨u, hu⟩] with ξ h1
    rw [h1]

/-- Schwartz functions lie in `H⁴`, where `L_r` acts as the differential operator. -/
theorem schwartz_mem {r a ks : ℝ} (ha : 0 < a) (φ : SchwartzMap Rd ℂ) :
    ∃ hφ : InH 2 (toL2 φ),
      Lr r ha.le ks ⟨toL2 φ, hφ⟩ = toL2 (Lop (2 * a * ks ^ 2) a (r - a * ks ^ 4) φ) :=
  (isGen_iff_Lr ha _ _).1 (isGen_of_ae _ _ _ (FU_Lop _ _ _ φ).symm)

/-! ### The semigroup `e^{tL_r}` -/

/-- The symbol `e^{t⁺λ_r}`. -/
def esr (r a ks t : ℝ) (ξ : Rd) : ℂ := (Real.exp (max t 0 * lamr r a ks ξ) : ℂ)

theorem esr_eq_esym (r a ks t : ℝ) (ξ : Rd) :
    esym (2 * a * ks ^ 2) a (r - a * ks ^ 4) t ξ = esr r a ks t ξ := by
  rw [esym, esr, lam_eq_lamr]

theorem continuous_esr (r a ks t : ℝ) : Continuous (esr (d := d) r a ks t) :=
  Complex.continuous_ofReal.comp (Real.continuous_exp.comp
    (continuous_const.mul (continuous_lamr r a ks)))

theorem norm_esr (r a ks t : ℝ) (ξ : Rd) :
    ‖esr r a ks t ξ‖ = Real.exp (max t 0 * lamr r a ks ξ) := by
  rw [esr, Complex.norm_real, Real.norm_of_nonneg (Real.exp_pos _).le]

theorem norm_esr_le {a : ℝ} (ha : 0 ≤ a) (r ks t : ℝ) (ξ : Rd) :
    ‖esr r a ks t ξ‖ ≤ Real.exp (max t 0 * r) := by
  rw [norm_esr]
  exact Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left (lamr_le ha r ks ξ) (le_max_right _ _))

/-- The semigroup `e^{tL_r} = 𝓕⁻¹ e^{t⁺λ_r} 𝓕`. -/
def Sr (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks t : ℝ) : L2 d →L[ℂ] L2 d :=
  fmul (esr r a ks t) (continuous_esr r a ks t).aestronglyMeasurable (norm_esr_le ha r ks t)

theorem FU_Sr (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks t : ℝ) (u : L2 d) :
    (FU (Sr r ha ks t u) : Rd → ℂ) =ᵐ[volume] fun ξ => esr r a ks t ξ * FU u ξ :=
  coeFn_FU_fmul _ _ _ u

/-- `e^{tL_r}` is the semigroup orbit of `SpectralConc` (with `(a, b, r) ↦ (2ak⋆², a, r − ak⋆⁴)`). -/
theorem Sr_eq_sol {r a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) (t : ℝ) (u : L2 d) :
    Sr r ha.le ks t u = sol (r - a * ks ^ 4) (by positivity : 0 < 2 * a * ks ^ 2) ha u t := by
  apply FU.injective; apply Lp.ext
  rw [FU_sol]
  filter_upwards [FU_Sr r ha.le ks t u,
    coeFn_solM (r - a * ks ^ 4) (by positivity : 0 < 2 * a * ks ^ 2) ha u t] with ξ h1 h2
  rw [h1, h2, esr_eq_esym]

theorem Sr_zero (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) :
    Sr (d := d) r ha ks 0 = ContinuousLinearMap.id ℂ _ := by
  ext1 u; apply FU.injective; apply Lp.ext
  filter_upwards [FU_Sr r ha ks 0 u] with ξ h
  simp [h, esr]

theorem Sr_add (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) {t s : ℝ} (ht : 0 ≤ t) (hs : 0 ≤ s) :
    Sr (d := d) r ha ks (t + s) = (Sr r ha ks t).comp (Sr r ha ks s) := by
  ext1 u; apply FU.injective; apply Lp.ext
  filter_upwards [FU_Sr r ha ks (t + s) u, FU_Sr r ha ks t (Sr r ha ks s u), FU_Sr r ha ks s u]
    with ξ h1 h2 h3
  rw [ContinuousLinearMap.comp_apply, h2, h1, h3, ← mul_assoc, esr, esr, esr,
    ← Complex.ofReal_mul, ← Real.exp_add, max_eq_left ht, max_eq_left hs,
    max_eq_left (add_nonneg ht hs)]
  congr 2; ring_nf

theorem continuous_Sr {r a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) (u : L2 d) :
    Continuous fun t => Sr r ha.le ks t u := by
  simp_rw [Sr_eq_sol ha hks]
  exact continuous_sol _ _ _ u

/-- **`‖e^{tL_r}‖ = e^{rt}`** for `t ≥ 0` (the supremum of the symbol is attained on the shell). -/
theorem opNorm_Sr (hd : 1 ≤ d) {r a ks : ℝ} (ha : 0 ≤ a) (hks : 0 ≤ ks) {t : ℝ} (ht : 0 ≤ t) :
    ‖Sr (d := d) r ha ks t‖ = Real.exp (r * t) := by
  obtain ⟨k₀, hk₀⟩ := exists_shell hd hks
  have hp : psym ks k₀ = 0 := (psym_eq_zero_iff hks k₀).2 hk₀
  have h := opNorm_fmul_eq_of_attained (continuous_esr r a ks t) (norm_esr_le ha r ks t)
    (ξ₀ := k₀) (by rw [norm_esr, lamr, hp, mul_zero, sub_zero])
  rw [Sr, h, max_eq_left ht, mul_comm]


/-! ### The spectrum `σ(L_r) = (−∞, r]` -/

/-- Every value `μ ≤ r` is attained by the symbol. -/
theorem exists_lamr_eq (hd : 1 ≤ d) {r a ks : ℝ} (ha : 0 < a) (hks : 0 ≤ ks) {μ : ℝ}
    (hμ : μ ≤ r) : ∃ ξ : Rd, lamr r a ks ξ = μ := by
  set e : Rd := EuclideanSpace.single (⟨0, hd⟩ : Fin d) 1 with he_def
  have he : ‖e‖ = 1 := by simp [e]
  set f : ℝ → ℝ := fun t => lamr r a ks (t • e) with hf_def
  have hf : Continuous f := (continuous_lamr r a ks).comp (continuous_id.smul continuous_const)
  have hft : ∀ t, 0 ≤ t → f t = r - a * (t ^ 2 - ks ^ 2) ^ 2 := fun t ht => by
    simp only [f, lamr, psym, norm_smul, he, mul_one, Real.norm_of_nonneg ht]
  set T := √(ks ^ 2 + 1 + (r - μ) / a) with hT
  have hrμ : 0 ≤ (r - μ) / a := div_nonneg (by linarith) ha.le
  have hT2 : T ^ 2 = ks ^ 2 + 1 + (r - μ) / a := Real.sq_sqrt (by positivity)
  have hksT : ks ≤ T := by
    rw [hT]; exact Real.le_sqrt_of_sq_le (by linarith)
  have h1 : f T ≤ μ := by
    rw [hft T (hks.trans hksT), hT2]
    have : (ks ^ 2 + 1 + (r - μ) / a - ks ^ 2) = 1 + (r - μ) / a := by ring
    rw [this]
    have h2 : (r - μ) / a ≤ (1 + (r - μ) / a) ^ 2 := by nlinarith
    have h3 : r - μ ≤ a * (1 + (r - μ) / a) ^ 2 := by
      calc r - μ = a * ((r - μ) / a) := by field_simp
        _ ≤ a * (1 + (r - μ) / a) ^ 2 := mul_le_mul_of_nonneg_left h2 ha.le
    linarith
  have h0 : μ ≤ f ks := by rw [hft ks hks]; simp [hμ]
  obtain ⟨t, -, ht⟩ := intermediate_value_Icc' hksT hf.continuousOn ⟨h1, h0⟩
  exact ⟨t • e, ht⟩

theorem norm_sub_lamr_ge (z : ℂ) (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) (ξ : Rd) :
    max |z.im| (z.re - r) ≤ ‖z - (lamr r a ks ξ : ℂ)‖ := by
  apply max_le
  · calc |z.im| = |(z - (lamr r a ks ξ : ℂ)).im| := by simp
      _ ≤ ‖z - (lamr r a ks ξ : ℂ)‖ := Complex.abs_im_le_norm _
  · calc z.re - r ≤ z.re - lamr r a ks ξ := by linarith [lamr_le ha r ks ξ]
      _ = (z - (lamr r a ks ξ : ℂ)).re := by simp
      _ ≤ ‖z - (lamr r a ks ξ : ℂ)‖ := Complex.re_le_norm _

/-- Off `(−∞, r]`, `z − L_r` has a bounded inverse mapping into `H⁴`. -/
theorem isResolvent_Lr {r a ks : ℝ} (ha : 0 < a) {z : ℂ} (hz : ¬ (z.im = 0 ∧ z.re ≤ r)) :
    IsResolvent (Lr (d := d) r ha.le ks) z := by
  set δ := max |z.im| (z.re - r) with hδ
  have hδ0 : 0 < δ := by
    by_cases h : z.im = 0
    · have : r < z.re := by
        by_contra h'; exact hz ⟨h, not_lt.1 h'⟩
      exact lt_max_of_lt_right (by linarith)
    · exact lt_max_of_lt_left (abs_pos.2 h)
  have hne : ∀ ξ : Rd, z - (lamr r a ks ξ : ℂ) ≠ 0 := fun ξ h => by
    have := norm_sub_lamr_ge z r ha.le ks ξ
    rw [h, norm_zero] at this; linarith
  set m : Rd → ℂ := fun ξ => 1 / (z - (lamr r a ks ξ : ℂ)) with hm_def
  have hmc : Continuous m := continuous_const.div
    (continuous_const.sub (Complex.continuous_ofReal.comp (continuous_lamr r a ks))) hne
  have hmb : ∀ ξ, ‖m ξ‖ ≤ 1 / δ := fun ξ => by
    rw [hm_def, norm_div, norm_one]
    exact one_div_le_one_div_of_le hδ0 (norm_sub_lamr_ge z r ha.le ks ξ)
  set R := fmul m hmc.aestronglyMeasurable hmb
  have hFR : ∀ f : L2 d, (FU (R f) : Rd → ℂ) =ᵐ[volume] fun ξ => m ξ * FU f ξ := fun f =>
    coeFn_FU_fmul _ _ _ f
  -- `R` maps into `H⁴`
  set C₂ := 2 * (1 + ks ^ 2) ^ 2 + 2 * |r| / a
  have hb2 : ∀ ξ : Rd, bw ξ ^ 2 ≤ 2 / a * |lamr r a ks ξ| + C₂ := fun ξ => by
    have h1 := bw_sq_le_psym ks ξ
    have h2 : a * psym ks ξ ≤ |lamr r a ks ξ| + |r| := by
      have : a * psym ks ξ = r - lamr r a ks ξ := by unfold lamr; ring
      rw [this]; linarith [neg_abs_le (lamr r a ks ξ), le_abs_self r]
    have h3 : psym ks ξ ≤ (|lamr r a ks ξ| + |r|) / a := by rw [le_div_iff₀ ha]; linarith
    have h4 : 2 / a * |lamr r a ks ξ| + 2 * |r| / a = 2 * ((|lamr r a ks ξ| + |r|) / a) := by ring
    simp only [C₂]; linarith
  set C₃ := 2 / a + (2 / a * ‖z‖ + C₂) / δ
  have hbm : ∀ ξ : Rd, ‖((bw ξ ^ 2 : ℝ) : ℂ) * m ξ‖ ≤ C₃ := fun ξ => by
    have hn := norm_sub_lamr_ge z r ha.le ks ξ
    have hpos : 0 < ‖z - (lamr r a ks ξ : ℂ)‖ := lt_of_lt_of_le hδ0 hn
    have hl : |lamr r a ks ξ| ≤ ‖z - (lamr r a ks ξ : ℂ)‖ + ‖z‖ := by
      have := norm_sub_le z (z - (lamr r a ks ξ : ℂ))
      rw [sub_sub_cancel, Complex.norm_real, Real.norm_eq_abs] at this
      linarith [norm_sub_rev z (z - (lamr r a ks ξ : ℂ))]
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity), hm_def, norm_div,
      norm_one, mul_one_div, div_le_iff₀ hpos]
    have hC₂ : 0 ≤ C₂ := by positivity
    have h1 : 2 / a * ‖z‖ + C₂ ≤ (2 / a * ‖z‖ + C₂) / δ * ‖z - (lamr r a ks ξ : ℂ)‖ := by
      calc 2 / a * ‖z‖ + C₂ = (2 / a * ‖z‖ + C₂) / δ * δ := by field_simp
        _ ≤ (2 / a * ‖z‖ + C₂) / δ * ‖z - (lamr r a ks ξ : ℂ)‖ :=
            mul_le_mul_of_nonneg_left hn (by positivity)
    have h2 := hb2 ξ
    have h3 : 2 / a * |lamr r a ks ξ| ≤ 2 / a * (‖z - (lamr r a ks ξ : ℂ)‖ + ‖z‖) :=
      mul_le_mul_of_nonneg_left hl (by positivity)
    simp only [C₃]; nlinarith
  have hmem : ∀ f : L2 d, InH 2 (R f) := fun f => by
    have hm2 : AEStronglyMeasurable (fun ξ : Rd => ((bw ξ ^ 2 : ℝ) : ℂ) * m ξ) volume :=
      ((Complex.continuous_ofReal.comp (continuous_bw.pow 2)).mul hmc).aestronglyMeasurable
    refine (memLp_mul hm2 hbm (FU f)).ae_eq ?_
    filter_upwards [hFR f] with ξ h
    rw [h]; ring
  refine ⟨R, hmem, fun f => ?_, fun u => ?_⟩
  · apply FU.injective; apply Lp.ext
    rw [map_sub, map_smul]
    filter_upwards [FU_Lr r ha.le ks ⟨R f, hmem f⟩, hFR f,
      Lp.coeFn_sub (z • FU (R f)) (FU (Lr r ha.le ks ⟨R f, hmem f⟩)),
      Lp.coeFn_smul z (FU (R f))] with ξ h1 h2 h3 h4
    rw [h3, Pi.sub_apply, h4, Pi.smul_apply, h1, smul_eq_mul]
    simp only [h2]
    rw [← sub_mul, ← mul_assoc, hm_def]
    field_simp [hne ξ]
  · apply FU.injective; apply Lp.ext
    have hu : InH 2 (u : L2 d) := u.2
    filter_upwards [hFR (z • (u : L2 d) - Lr r ha.le ks u), FU_Lr r ha.le ks u,
      Lp.coeFn_sub (z • FU (u : L2 d)) (FU (Lr r ha.le ks u)),
      Lp.coeFn_smul z (FU (u : L2 d))] with ξ h1 h2 h3 h4
    rw [h1, map_sub, map_smul, h3, Pi.sub_apply, h4, Pi.smul_apply, h2, smul_eq_mul, ← sub_mul,
      ← mul_assoc, hm_def]
    field_simp [hne ξ]

/-- On `(−∞, r]`, approximate eigenvectors with Fourier support near a level point. -/
theorem mem_spectrum_Lr (hd : 1 ≤ d) {r a ks : ℝ} (ha : 0 < a) (hks : 0 ≤ ks) {z : ℂ}
    (hz : z.im = 0 ∧ z.re ≤ r) : z ∈ uspectrum (Lr (d := d) r ha.le ks) := by
  obtain ⟨ξ₀, hξ₀⟩ := exists_lamr_eq hd ha hks hz.2
  have hzr : z = (z.re : ℂ) := Complex.ext (by simp) (by simp [hz.1])
  apply mem_uspectrum_of_approx
  intro ε hε
  obtain ⟨ρ, hρ, hball⟩ := Metric.continuous_iff.1 (continuous_lamr (d := d) r a ks) ξ₀ ε hε
  have hU : MeasurableSet (Metric.ball ξ₀ ρ) := measurableSet_ball
  have hfin : volume (Metric.ball ξ₀ ρ) ≠ ⊤ := measure_ball_lt_top.ne
  set g := ind (Metric.ball ξ₀ ρ) hU hfin
  set u := FU.symm g
  have hFu : FU u = g := LinearIsometryEquiv.apply_symm_apply _ _
  have hu : InH 2 u := by
    refine inH_of_bounded (R := ‖ξ₀‖ + ρ) ?_
    rw [hFu]
    filter_upwards [coeFn_ind (Metric.ball ξ₀ ρ) hU hfin] with ξ h hξ
    rw [h, Set.indicator_of_notMem]
    intro hmem
    rw [Metric.mem_ball, dist_eq_norm] at hmem
    have := norm_le_norm_add_norm_sub' ξ ξ₀
    have := norm_sub_rev ξ ξ₀
    linarith [norm_sub_norm_le ξ ξ₀]
  have hpos : 0 < (volume (Metric.ball ξ₀ ρ)).toReal :=
    ENNReal.toReal_pos (Metric.measure_ball_pos volume ξ₀ hρ).ne' hfin
  refine ⟨⟨u, hu⟩, ?_, ?_⟩
  · intro h
    have : ‖g‖ ^ 2 = 0 := by
      rw [← hFu]
      rw [show (u : L2 d) = 0 from h, map_zero, norm_zero]; ring
    rw [norm_ind_sq] at this
    linarith
  · have key : ‖z • u - Lr r ha.le ks ⟨u, hu⟩‖ ^ 2 ≤ (ε * ‖u‖) ^ 2 := by
      rw [← norm_FU (z • u - _), SpectralConc.norm_sq_L2, mul_pow, ← norm_FU u,
        SpectralConc.norm_sq_L2, ← integral_const_mul]
      refine integral_mono_ae (integrable_norm_sq_L2 _) ((integrable_norm_sq_L2 _).const_mul _) ?_
      rw [map_sub, map_smul]
      filter_upwards [FU_Lr r ha.le ks ⟨u, hu⟩,
        Lp.coeFn_sub (z • FU u) (FU (Lr r ha.le ks ⟨u, hu⟩)), Lp.coeFn_smul z (FU u),
        coeFn_ind (Metric.ball ξ₀ ρ) hU hfin] with ξ h1 h2 h3 h4
      change ‖(z • FU u - FU (Lr r ha.le ks ⟨u, hu⟩) : L2 d) ξ‖ ^ 2 ≤ ε ^ 2 * ‖FU u ξ‖ ^ 2
      rw [h2, Pi.sub_apply, h3, Pi.smul_apply, h1, smul_eq_mul, ← sub_mul, norm_mul, mul_pow]
      by_cases hmem : ξ ∈ Metric.ball ξ₀ ρ
      · refine mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) ?_ 2) (by positivity)
        have h5 := hball ξ hmem
        rw [Real.dist_eq, hξ₀] at h5
        rw [hzr, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, abs_sub_comm]
        exact h5.le
      · have : FU u ξ = 0 := by
          rw [show (FU u : Rd → ℂ) ξ = (g : Rd → ℂ) ξ by rw [hFu], h4,
            Set.indicator_of_notMem hmem]
        rw [this, norm_zero]; simp
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).1 key

/-- **The spectrum of the Swift–Hohenberg operator**: `σ(L_r) = (−∞, r]`. -/
theorem spectrum_Lr (hd : 1 ≤ d) {r a ks : ℝ} (ha : 0 < a) (hks : 0 ≤ ks) :
    uspectrum (Lr (d := d) r ha.le ks) = {z : ℂ | z.im = 0 ∧ z.re ≤ r} := by
  ext z
  constructor
  · intro hz
    by_contra h
    exact hz (isResolvent_Lr ha h)
  · exact mem_spectrum_Lr hd ha hks


/-! ### The generator of `e^{tL_r}` is `L_r` with domain `H⁴` -/

/-- `|eˣ − 1| ≤ |x| e^{max x 0}`. -/
theorem abs_exp_sub_one_le' (x : ℝ) : |Real.exp x - 1| ≤ |x| * Real.exp (max x 0) := by
  rcases le_or_gt x 0 with hx | hx
  · rw [max_eq_right hx, Real.exp_zero, mul_one,
      abs_of_nonpos (by linarith [Real.exp_le_one_iff.2 hx]), abs_of_nonpos hx]
    linarith [Real.add_one_le_exp x]
  · rw [max_eq_left hx.le, abs_of_nonneg (by linarith [Real.one_le_exp hx.le]), abs_of_pos hx]
    have h1 := Real.add_one_le_exp (-x)
    have h2 : Real.exp (-x) * Real.exp x = 1 := by rw [← Real.exp_add]; simp
    nlinarith [mul_nonneg (sub_nonneg.2 h1) (Real.exp_pos x).le]

/-- **The generator, part 1**: for `u ∈ H⁴`, `h⁻¹(e^{hL_r}u − u) → L_r u` in `L²` as `h ↓ 0`. -/
theorem generator {r a ks : ℝ} (ha : 0 ≤ a) {u : L2 d} (hu : InH 2 u) :
    Tendsto (fun h : ℝ => ((h⁻¹ : ℝ) : ℂ) • (Sr r ha ks h u - u)) (𝓝[>] 0)
      (𝓝 (Lr r ha ks ⟨u, hu⟩)) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  set F : ℝ → Rd → ℝ := fun h ξ =>
    ((Real.exp (h * lamr r a ks ξ) - 1) / h - lamr r a ks ξ) ^ 2 * ‖FU u ξ‖ ^ 2 with hF
  have hsq : ∀ h : ℝ, 0 < h →
      ‖((h⁻¹ : ℝ) : ℂ) • (Sr r ha ks h u - u) - Lr r ha ks ⟨u, hu⟩‖ ^ 2 = ∫ ξ, F h ξ := by
    intro h hh
    rw [← norm_FU, SpectralConc.norm_sq_L2]
    refine integral_congr_ae ?_
    rw [map_sub, map_smul, map_sub]
    filter_upwards [FU_Sr r ha ks h u, FU_Lr r ha ks ⟨u, hu⟩,
      Lp.coeFn_sub (((h⁻¹ : ℝ) : ℂ) • (FU (Sr r ha ks h u) - FU u)) (FU (Lr r ha ks ⟨u, hu⟩)),
      Lp.coeFn_smul ((h⁻¹ : ℝ) : ℂ) (FU (Sr r ha ks h u) - FU u),
      Lp.coeFn_sub (FU (Sr r ha ks h u)) (FU u)] with ξ h1 h2 h3 h4 h5
    simp only [hF]
    rw [h3, Pi.sub_apply, h4, Pi.smul_apply, h5, Pi.sub_apply, h1, h2, smul_eq_mul, esr,
      max_eq_left hh.le]
    rw [show ((h⁻¹ : ℝ) : ℂ) * ((Real.exp (h * lamr r a ks ξ) : ℂ) * FU u ξ - FU u ξ) -
        (lamr r a ks ξ : ℂ) * FU u ξ =
        (((Real.exp (h * lamr r a ks ξ) - 1) / h - lamr r a ks ξ : ℝ) : ℂ) * FU u ξ by
      push_cast; ring]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs]
  have hlam : MemLp (fun ξ => (lamr r a ks ξ : ℂ) * FU u ξ) 2 volume :=
    memLp_mul_of_inH (aesm_lamr r a ks) (norm_lamr_le ha r ks) hu
  have hlam_int : Integrable (fun ξ => lamr r a ks ξ ^ 2 * ‖FU u ξ‖ ^ 2) := by
    refine (integrable_norm_sq_L2 (hlam.toLp _ : L2 d)).congr ?_
    filter_upwards [hlam.coeFn_toLp] with ξ h
    rw [h, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs]
  have hlim : Tendsto (fun h => ∫ ξ, F h ξ) (𝓝[>] 0) (𝓝 0) := by
    have := tendsto_integral_filter_of_dominated_convergence (l := 𝓝[>] (0 : ℝ)) (F := F)
      (f := fun _ => (0 : ℝ))
      (fun ξ => (Real.exp |r| + 1) ^ 2 * (lamr r a ks ξ ^ 2 * ‖FU u ξ‖ ^ 2)) ?_ ?_
      (hlam_int.const_mul _) ?_
    · simpa using this
    · refine Eventually.of_forall fun h => ?_
      exact ((((Real.continuous_exp.comp (continuous_const.mul (continuous_lamr r a ks))).sub
        continuous_const).div_const h).sub (continuous_lamr r a ks)).pow 2
        |>.aestronglyMeasurable.mul ((Lp.aestronglyMeasurable (FU u)).norm.pow 2)
    · filter_upwards [Ioc_mem_nhdsGT one_pos] with h hh
      refine Eventually.of_forall fun ξ => ?_
      have hh0 : 0 < h := hh.1
      have hh1 : h ≤ 1 := hh.2
      have hl : lamr r a ks ξ ≤ r := lamr_le ha r ks ξ
      have e1 := abs_exp_sub_one_le' (h * lamr r a ks ξ)
      have e2 : max (h * lamr r a ks ξ) 0 ≤ |r| := by
        refine max_le ?_ (abs_nonneg r)
        rcases le_or_gt (lamr r a ks ξ) 0 with hl0 | hl0
        · nlinarith [abs_nonneg r]
        · nlinarith [le_abs_self r]
      have e3 : |(Real.exp (h * lamr r a ks ξ) - 1) / h| ≤ |lamr r a ks ξ| * Real.exp |r| := by
        rw [abs_div, abs_of_pos hh0, div_le_iff₀ hh0]
        calc |Real.exp (h * lamr r a ks ξ) - 1|
            ≤ |h * lamr r a ks ξ| * Real.exp (max (h * lamr r a ks ξ) 0) := e1
          _ ≤ |h * lamr r a ks ξ| * Real.exp |r| :=
              mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 e2) (abs_nonneg _)
          _ = |lamr r a ks ξ| * Real.exp |r| * h := by rw [abs_mul, abs_of_pos hh0]; ring
      have e4 : |(Real.exp (h * lamr r a ks ξ) - 1) / h - lamr r a ks ξ| ≤
          |lamr r a ks ξ| * (Real.exp |r| + 1) := by
        have := norm_sub_le ((Real.exp (h * lamr r a ks ξ) - 1) / h) (lamr r a ks ξ)
        simp only [Real.norm_eq_abs] at this
        linarith
      simp only [hF]
      rw [Real.norm_of_nonneg (by positivity)]
      calc ((Real.exp (h * lamr r a ks ξ) - 1) / h - lamr r a ks ξ) ^ 2 * ‖FU u ξ‖ ^ 2
          = |(Real.exp (h * lamr r a ks ξ) - 1) / h - lamr r a ks ξ| ^ 2 * ‖FU u ξ‖ ^ 2 := by
            rw [sq_abs]
        _ ≤ (|lamr r a ks ξ| * (Real.exp |r| + 1)) ^ 2 * ‖FU u ξ‖ ^ 2 :=
            mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (abs_nonneg _) e4 2) (by positivity)
        _ = (Real.exp |r| + 1) ^ 2 * (lamr r a ks ξ ^ 2 * ‖FU u ξ‖ ^ 2) := by
            rw [mul_pow, sq_abs]; ring
    · refine Eventually.of_forall fun ξ => ?_
      set l := lamr r a ks ξ
      have hd : HasDerivAt (fun h : ℝ => Real.exp (h * l)) l 0 := by
        have := ((hasDerivAt_id (0 : ℝ)).mul_const l).exp
        simpa using this
      have hs := (hasDerivAt_iff_tendsto_slope.1 hd).mono_left
        (nhdsWithin_mono (0 : ℝ) fun x (hx : 0 < x) => ne_of_gt hx)
      have hs' : Tendsto (fun h : ℝ => (Real.exp (h * l) - 1) / h) (𝓝[>] 0) (𝓝 l) := by
        refine hs.congr' (eventually_nhdsWithin_of_forall fun h _ => ?_)
        simp [slope_def_field]
      have := ((hs'.sub_const l).pow 2).mul_const (‖FU u ξ‖ ^ 2)
      simpa [hF] using this
  have h2 : Tendsto (fun h => ‖((h⁻¹ : ℝ) : ℂ) • (Sr r ha ks h u - u) - Lr r ha ks ⟨u, hu⟩‖ ^ 2)
      (𝓝[>] 0) (𝓝 0) :=
    hlim.congr' (eventually_nhdsWithin_of_forall fun h hh => (hsq h hh).symm)
  have h3 := h2.sqrt
  simpa only [Real.sqrt_sq (norm_nonneg _), Real.sqrt_zero] using h3

/-- `e^{tL_r}` is self-adjoint (real symbol). -/
theorem inner_Sr (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks t : ℝ) (v u : L2 d) :
    ⟪v, Sr r ha ks t u⟫_ℂ = ⟪Sr r ha ks t v, u⟫_ℂ := by
  rw [inner_FU_eq, inner_FU_eq]
  apply integral_congr_ae
  filter_upwards [FU_Sr r ha ks t u, FU_Sr r ha ks t v] with ξ h1 h2
  rw [h1, h2, map_mul, esr, Complex.conj_ofReal]; ring

/-- **The generator, part 2**: if `h⁻¹(e^{hL_r}u − u)` converges in `L²` as `h ↓ 0`, then
`u ∈ H⁴` and the limit is `L_r u`. With part 1, the generator of `e^{tL_r}` is exactly `L_r`
with domain `H⁴`. -/
theorem generator_domain {r a ks : ℝ} (ha : 0 < a) {u w : L2 d}
    (h : Tendsto (fun h : ℝ => ((h⁻¹ : ℝ) : ℂ) • (Sr r ha.le ks h u - u)) (𝓝[>] 0) (𝓝 w)) :
    ∃ hu : InH 2 u, Lr r ha.le ks ⟨u, hu⟩ = w := by
  refine (isGen_iff_Lr ha u w).1 fun φ => ?_
  obtain ⟨hφ, hLφ⟩ := schwartz_mem (r := r) (ks := ks) ha φ
  rw [← hLφ]
  have h1 := Filter.Tendsto.inner (𝕜 := ℂ) (tendsto_const_nhds (x := toL2 φ)) h
  have h2 := Filter.Tendsto.inner (𝕜 := ℂ) (generator (r := r) (ks := ks) ha.le hφ)
    (tendsto_const_nhds (x := u))
  have e : ∀ h : ℝ, ⟪toL2 φ, ((h⁻¹ : ℝ) : ℂ) • (Sr r ha.le ks h u - u)⟫_ℂ =
      ⟪((h⁻¹ : ℝ) : ℂ) • (Sr r ha.le ks h (toL2 φ) - toL2 φ), u⟫_ℂ := fun h => by
    rw [inner_smul_right, inner_smul_left, Complex.conj_ofReal, inner_sub_right, inner_sub_left,
      inner_Sr]
  simp_rw [e] at h1
  exact tendsto_nhds_unique h2 h1

/-! ### Self-adjointness and nonnegativity of `𝒜` -/

theorem inH_toL2 (φ : SchwartzMap Rd ℂ) : InH 2 (toL2 φ) :=
  ((isGen_iff_Aop 0 _ _).1 (isGen_of_ae _ _ _ (FU_Lop _ _ _ φ).symm)).1

theorem Aop_toL2 (ks : ℝ) (φ : SchwartzMap Rd ℂ) :
    Aop ks ⟨toL2 φ, inH_toL2 φ⟩ = toL2 (Lop (-2 * ks ^ 2) (-1) (ks ^ 4) φ) :=
  ((isGen_iff_Aop ks _ _).1 (isGen_of_ae _ _ _ (FU_Lop (-2 * ks ^ 2) (-1) (ks ^ 4) φ).symm)).2

theorem dense_Hdom : Dense ((Hdom (d := d) 2 : Submodule ℂ (L2 d)) : Set (L2 d)) :=
  Dense.mono (fun x hx => by obtain ⟨φ, rfl⟩ := hx; exact inH_toL2 φ) denseRange_toL2

theorem Aop_isFormalAdjoint (ks : ℝ) : (Aop (d := d) ks).IsFormalAdjoint (Aop ks) := by
  intro u v
  rw [inner_FU_eq, inner_FU_eq]
  apply integral_congr_ae
  filter_upwards [FU_Aop ks u, FU_Aop ks v] with ξ h1 h2
  rw [h1, h2, map_mul, Complex.conj_ofReal]; ring

/-- Elements of the adjoint's domain lie in `H⁴`, where `𝒜†` acts as `𝒜`. -/
theorem adjoint_mem (ks : ℝ) (v : (Aop (d := d) ks).adjoint.domain) :
    ∃ hv : InH 2 (v : L2 d), Aop ks ⟨(v : L2 d), hv⟩ = (Aop ks).adjoint v := by
  have hdense : Dense ((Aop (d := d) ks).domain : Set (L2 d)) := dense_Hdom
  refine (isGen_iff_Aop ks _ _).1 fun φ => ?_
  have h := LinearPMap.adjoint_isFormalAdjoint hdense v ⟨toL2 φ, inH_toL2 φ⟩
  rw [Aop_toL2] at h
  calc ⟪toL2 (Lop (-2 * ks ^ 2) (-1) (ks ^ 4) φ), (v : L2 d)⟫_ℂ
      = conj ⟪(v : L2 d), toL2 (Lop (-2 * ks ^ 2) (-1) (ks ^ 4) φ)⟫_ℂ :=
        (inner_conj_symm _ _).symm
    _ = conj ⟪(Aop ks).adjoint v, toL2 φ⟫_ℂ := by rw [h]
    _ = ⟪toL2 φ, (Aop ks).adjoint v⟫_ℂ := inner_conj_symm _ _

theorem adjoint_le (ks : ℝ) : (Aop (d := d) ks).adjoint ≤ Aop ks := by
  refine ⟨fun v hv => (adjoint_mem ks ⟨v, hv⟩).1, fun x y hxy => ?_⟩
  obtain ⟨hx, hx'⟩ := adjoint_mem ks x
  rw [← hx']
  congr 1
  exact Subtype.ext hxy

/-- **`𝒜 = (Δ + k⋆²)²` with domain `H⁴` is self-adjoint.** -/
theorem Aop_isSelfAdjoint (ks : ℝ) : IsSelfAdjoint (Aop (d := d) ks) := by
  have hdense : Dense ((Aop (d := d) ks).domain : Set (L2 d)) := dense_Hdom
  have h1 : Aop (d := d) ks ≤ (Aop ks).adjoint := (Aop_isFormalAdjoint ks).le_adjoint hdense
  have h2 : (Aop (d := d) ks).adjoint = Aop ks := le_antisymm (adjoint_le ks) h1
  exact LinearPMap.isSelfAdjoint_def.2 h2

theorem norm_shift_le (ks : ℝ) (ξ : Rd) :
    ‖(((ks ^ 2 - ‖ξ‖ ^ 2 : ℝ)) : ℂ)‖ ≤ (ks ^ 2 + 1) * bw ξ ^ 1 := by
  rw [Complex.norm_real, Real.norm_eq_abs, pow_one]
  unfold bw
  have h0 : 0 ≤ ‖ξ‖ ^ 2 := by positivity
  rw [abs_le]; constructor <;> nlinarith [sq_nonneg ks]

/-- `B = Δ + k⋆²` with domain `H²` (symbol `k⋆² − |ξ|²`). -/
def Bop (ks : ℝ) : L2 d →ₗ.[ℂ] L2 d :=
  pmulOp 1 (fun ξ => ((ks ^ 2 - ‖ξ‖ ^ 2 : ℝ) : ℂ))
    (Complex.continuous_ofReal.comp
      (continuous_const.sub (continuous_norm.pow 2))).aestronglyMeasurable (norm_shift_le ks)

theorem FU_Bop (ks : ℝ) (u : (Bop (d := d) ks).domain) :
    (FU (Bop ks u) : Rd → ℂ) =ᵐ[volume]
      fun ξ => ((ks ^ 2 - ‖ξ‖ ^ 2 : ℝ) : ℂ) * FU (u : L2 d) ξ :=
  FU_pmulOp 1 _ _ _ u

/-- **Nonnegativity**: `⟨u, 𝒜u⟩ = ∫ p|û|² = ‖(Δ + k⋆²)u‖² ≥ 0` on `H⁴`. -/
theorem inner_Aop (ks : ℝ) {u : L2 d} (hu : InH 2 u) :
    ⟪u, Aop ks ⟨u, hu⟩⟫_ℂ = ((∫ ξ, psym ks ξ * ‖FU u ξ‖ ^ 2 : ℝ) : ℂ) ∧
    (∫ ξ, psym ks ξ * ‖FU u ξ‖ ^ 2) =
      ‖Bop ks ⟨u, inH_mono (j := 1) (k := 2) (by norm_num) hu⟩‖ ^ 2 ∧
    0 ≤ (⟪u, Aop ks ⟨u, hu⟩⟫_ℂ).re := by
  have h1 : ⟪u, Aop ks ⟨u, hu⟩⟫_ℂ = ((∫ ξ, psym ks ξ * ‖FU u ξ‖ ^ 2 : ℝ) : ℂ) := by
    rw [inner_FU_eq, ← integral_complex_ofReal]
    refine integral_congr_ae ?_
    filter_upwards [FU_Aop ks ⟨u, hu⟩] with ξ h
    rw [h, mul_left_comm, Complex.conj_mul', ← Complex.ofReal_pow]; push_cast; ring
  have h2 : (∫ ξ, psym ks ξ * ‖FU u ξ‖ ^ 2) =
      ‖Bop ks ⟨u, inH_mono (j := 1) (k := 2) (by norm_num) hu⟩‖ ^ 2 := by
    rw [← norm_FU, SpectralConc.norm_sq_L2]
    refine integral_congr_ae ?_
    filter_upwards [FU_Bop ks ⟨u, inH_mono (j := 1) (k := 2) (by norm_num) hu⟩] with ξ h
    rw [h, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs, psym]
    ring
  refine ⟨h1, h2, ?_⟩
  rw [h1, Complex.ofReal_re, h2]
  positivity


/-! ### Mild solutions of `∂ₜu = L_r u` -/

/-- `u` is an `L²` mild solution of `∂ₜu = L_r u`, `u(0) = u₀`: `u ∈ C([0,∞); L²)`, and for every
`t ≥ 0`, `∫₀ᵗ u ∈ H⁴ = D(L_r)` with `L_r ∫₀ᵗ u = u(t) − u₀`. -/
def IsMildSH (r : ℝ) {a : ℝ} (ha : 0 ≤ a) (ks : ℝ) (u₀ : L2 d) (u : ℝ → L2 d) : Prop :=
  ContinuousOn u (Ici 0) ∧ u 0 = u₀ ∧
    ∀ t, 0 ≤ t → ∃ h : InH 2 (∫ s in (0 : ℝ)..t, u s), Lr r ha ks ⟨_, h⟩ = u t - u₀

theorem isMildSH_iff {r a ks : ℝ} (ha : 0 < a) (u₀ : L2 d) (u : ℝ → L2 d) :
    IsMildSH r ha.le ks u₀ u ↔ IsMild (2 * a * ks ^ 2) a (r - a * ks ^ 4) u₀ u := by
  unfold IsMildSH IsMild
  simp_rw [isGen_iff_Lr ha]

/-- **Existence and uniqueness** of the mild solution, `u(t) = e^{tL_r}u₀`. -/
theorem mild_iff {r a ks : ℝ} (ha : 0 < a) (hks : 0 < ks) (u₀ : L2 d) :
    IsMildSH r ha.le ks u₀ (fun t => Sr r ha.le ks t u₀) ∧
    ∀ u : ℝ → L2 d, IsMildSH r ha.le ks u₀ u → ∀ t, 0 ≤ t → u t = Sr r ha.le ks t u₀ := by
  have hA : 0 < 2 * a * ks ^ 2 := by positivity
  refine ⟨?_, fun u hu t ht => ?_⟩
  · rw [isMildSH_iff ha]
    simp_rw [Sr_eq_sol ha hks]
    exact isMild_sol (r - a * ks ^ 4) hA ha u₀
  · rw [isMildSH_iff ha] at hu
    rw [mild_unique (r - a * ks ^ 4) hA ha hu ht, Sr_eq_sol ha hks]

