/-- A rational, strictly positive enclosure of the determinant of `middle`
itself, with the source's exact decimal arguments and amplitude. -/
theorem middle_det_bounds :
    (18000000 : ℝ) < middle.det ∧ middle.det < 24000000 := by
  have hs0 := (primary_12).1
  have hb0 : Bounds ((12707037 / 6250)) ((51029847 / 25000)) ((2241.1 : ℝ) * Real.cos ((5.0632 : ℝ) * 12 + 1.6469)) := by
    convert (Bounds.point (2241.1 : ℝ)).mul (primary_12).2 using 1 <;> norm_num
  have ht0 := (harmonic_12).1
  have hs1 := (primary_19).1
  have hb1 : Bounds ((-201093903 / 100000)) ((-100020293 / 50000)) ((2241.1 : ℝ) * Real.cos ((5.0632 : ℝ) * 19 + 1.6469)) := by
    convert (Bounds.point (2241.1 : ℝ)).mul (primary_19).2 using 1 <;> norm_num
  have ht1 := (harmonic_19).1
  have hs2 := (primary_53).1
  have hb2 : Bounds ((55108649 / 25000)) ((110239709 / 50000)) ((2241.1 : ℝ) * Real.cos ((5.0632 : ℝ) * 53 + 1.6469)) := by
    convert (Bounds.point (2241.1 : ℝ)).mul (primary_53).2 using 1 <;> norm_num
  have ht2 := (harmonic_53).1
  have hs3 := (primary_73).1
  have hb3 : Bounds ((23598783 / 12500)) ((191008953 / 100000)) ((2241.1 : ℝ) * Real.cos ((5.0632 : ℝ) * 73 + 1.6469)) := by
    convert (Bounds.point (2241.1 : ℝ)).mul (primary_73).2 using 1 <;> norm_num
  have ht3 := (harmonic_73).1
  have hs4 := (primary_91).1
  have hb4 : Bounds ((-46816579 / 25000)) ((-184509763 / 100000)) ((2241.1 : ℝ) * Real.cos ((5.0632 : ℝ) * 91 + 1.6469)) := by
    convert (Bounds.point (2241.1 : ℝ)).mul (primary_91).2 using 1 <;> norm_num
  have ht4 := (harmonic_91).1
  have h := det_shape_bounds hs0 hs1 hs2 hs3 hs4 hb0 hb1 hb2 hb3 hb4 ht0 ht1 ht2 ht3 ht4
  change Bounds _ _ middle.det at h
  constructor <;> linarith only [h.1, h.2]

theorem middle_det_pos : 0 < middle.det := lt_trans (by norm_num) middle_det_bounds.1

theorem middle_det_ne_zero : middle.det ≠ 0 := ne_of_gt middle_det_pos

/-- Unconditional nonsingularity of the product of the three frozen blocks.
Identification with the full observation derivative is a separate obligation. -/
theorem determinant_product_nonzero (alpha epsilon : ℝ) :
    (V18LightJacobian.minor alpha epsilon).det *
      middle.det * V18HeavyJacobian.heavy.det ≠ 0 :=
  determinant_product_nonzero_of_middle alpha epsilon middle_det_ne_zero

end ReyesMath.V18MiddleJacobian
